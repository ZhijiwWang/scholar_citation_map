# Copy this file to .env and enter your own settings.
# Gemini uses Google Cloud Application Default Credentials, not an API key.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Optional: an existing organization-provided ADC or federation configuration.
# Leave unset when using gcloud auth application-default login.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json

# Required only with --provider serpapi.
SERPAPI_API_KEY=

# Optional OpenAlex key for metadata requests.
OPENALEX_API_KEY=

# Optional contact email sent to OpenAlex with metadata requests.
CONTACT_EMAIL=
